{
  "name": "student-attendance-system",
  "version": "1.0.0",
  "description": "Enterprise-grade Student Attendance Management System with Real-Time Analytics and QR Check-in",
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently -k -n \"API,WEB\" -c \"blue.bold,magenta.bold\" \"npm run server\" \"npm run client\"",
    "server": "node server/server.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "seed": "node server/db/seed.js",
    "start": "node server/server.js"
  },
  "keywords": [
    "student-attendance",
    "attendance-management",
    "react",
    "express",
    "sqlite"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
